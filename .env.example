# ==========================================
# KANJI WEB APPLICATION - ENVIRONMENT CONFIG
# ==========================================
# Copy file này thành .env và điền thông tin của bạn

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT_SERVER=3000
AI_SERVER_URL=http://127.0.0.1:8000

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_NAME=kanji
DB_USER=admin
DB_PASSWORD=your_secure_password_here  # ⚠️ THAY ĐỔI PASSWORD!
DB_PORT=5432
DB_ADDRESS=127.0.0.1

# DATABASE_URL sẽ tự động được tạo từ các biến trên
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_ADDRESS}:${DB_PORT}/${DB_NAME}?schema=public"

# ==========================================
# JWT AUTHENTICATION
# ==========================================
# ⚠️ QUAN TRỌNG: Thay đổi các secret key này!
# Tạo secret key ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_key_256_bit_minimum
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_DAYS=30

# ==========================================
# MAIL CONFIGURATION (Gmail SMTP)
# ==========================================
# Để gửi email reset password, verify account, etc.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com          # ⚠️ Email của bạn
MAIL_PASSWORD=your_app_password_here    # ⚠️ App Password (không phải password thường!)
MAIL_FROM=noreply@kanjiapp.com

# Cách tạo Gmail App Password:
# 1. Truy cập: https://myaccount.google.com/security
# 2. Bật 2-Step Verification
# 3. Vào App passwords: https://myaccount.google.com/apppasswords
# 4. Chọn "Mail" và "Other (Custom name)"
# 5. Nhập tên "Kanji Web App"
# 6. Copy password 16 ký tự (dạng: xxxx xxxx xxxx xxxx)
# 7. Dán vào MAIL_PASSWORD (bỏ khoảng trắng)

# ==========================================
# DOCKER CONFIGURATION (Optional)
# ==========================================
# Uncomment nếu chạy với Docker
# DB_ADDRESS=db
# AI_SERVER_URL=http://ai-server:8000

# ==========================================
# LOGGING & DEBUGGING
# ==========================================
# LOG_LEVEL=debug    # Uncomment để bật debug logs
# NODE_ENV=development
