# Environment Variables Example

# Copy this file to .env and update with your actual values

#App
APP_VERSION=1.0.0
APP_NAME=Kanji Learning App
APP_URL=http://localhost:3000

#Server
PORT_SERVER=3000
AI_SERVER_URL=http://127.0.0.1:8000

#DB
DB_NAME=kanji
DB_USER=admin
DB_PASSWORD=your_database_password
DB_PORT=5432
DB_ADDRESS=127.0.0.1
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_ADDRESS}:${DB_PORT}/${DB_NAME}?schema=public"

#JWT
JWT_ACCESS_SECRET=your-very-secret-access-key-change-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
JWT_SECRET=your-jwt-secret-key-change-this

#Mail Configuration
# For Gmail: Use App-Specific Password (https://myaccount.google.com/apppasswords)
# For other providers: Use SMTP credentials
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM=noreply@kanjiapp.com

# Mail Configuration Examples:
# 
# Gmail:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USER=your-email@gmail.com
#   MAIL_PASSWORD=your-16-digit-app-password
#
# SendGrid:
#   MAIL_HOST=smtp.sendgrid.net
#   MAIL_PORT=587
#   MAIL_USER=apikey
#   MAIL_PASSWORD=your-sendgrid-api-key
#
# AWS SES:
#   MAIL_HOST=email-smtp.us-east-1.amazonaws.com
#   MAIL_PORT=587
#   MAIL_USER=your-smtp-username
#   MAIL_PASSWORD=your-smtp-password
#
# Outlook/Office 365:
#   MAIL_HOST=smtp.office365.com
#   MAIL_PORT=587
#   MAIL_USER=your-email@outlook.com
#   MAIL_PASSWORD=your-password
