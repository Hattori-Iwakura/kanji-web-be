// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

model Users {
  id             Int      @id @default(autoincrement())
  account        String   @unique
  hash_password  String
  email          String   @unique
  profile_image  String?
  role           UserRole @default(USER)
  is_system      Boolean  @default(false)
  is_active      Boolean  @default(true)
  is_first_login Boolean  @default(true)
  create_at      DateTime @default(now())
  update_at      DateTime @updatedAt

  sessions                   UserSession[]
  KanjiCollections           KanjiCollections[]
  Quizzes                    Quiz[]
  QuizResults                QuizResult[]
  FlashcardDecks             FlashcardDeck[]
  PublicDeckRequests         PublicDeckRequest[] @relation("UserPublicRequests")
  ReviewedPublicDeckRequests PublicDeckRequest[] @relation("AdminReviewedRequests")
  PublicQuizRequests         PublicQuizRequest[] @relation("UserPublicQuizRequests")
  ReviewedPublicQuizRequests PublicQuizRequest[] @relation("AdminReviewedQuizRequests")
  UserProfile                UserProfile?
  LearningHistory            LearningHistory[]
  CommunityPosts             CommunityPost[]
  CommunityComments          CommunityComment[]
  PostLikes                  PostLike[]
  CommentLikes               CommentLike[]
}

model UserSession {
  id               Int      @id @default(autoincrement())
  sessionId        String   @unique
  userId           Int
  user             Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String?
  revoked          Boolean  @default(false)
  userAgent        String?
  ip               String?
  createdAt        DateTime @default(now())
  lastActiveAt     DateTime @default(now())
  expiresAt        DateTime
  metadata         Json?

  @@index([userId])
  @@index([sessionId])
}

model Kanji {
  id           Int      @id @default(autoincrement())
  character    String   @unique
  onyomi       String?
  kunyomi      String?
  meanings     String
  stroke_count Int?
  jlpt         Int?
  grade        Int?
  frequency    Int?
  radicals     String?
  create_at    DateTime @default(now())
  update_at    DateTime @updatedAt

  KanjiCollectionItems KanjiCollectionItems[]
  QuizQuestions        QuizQuestion[]
  FlashcardCards       FlashcardCard[]
}

model KanjiCollections {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  user_id         Int? // null = public collection
  is_public       Boolean  @default(false)
  collection_type String   @default("custom") // "custom", "jlpt", "grade", "category"
  metadata        Json? // store additional config like jlpt level, category ids, etc.
  create_at       DateTime @default(now())
  update_at       DateTime @updatedAt

  Users                Users?                 @relation(fields: [user_id], references: [id])
  KanjiCollectionItems KanjiCollectionItems[]

  @@index([user_id])
  @@index([collection_type])
}

model KanjiCollectionItems {
  id            Int      @id @default(autoincrement())
  collection_id Int
  kanji_id      Int
  order_index   Int? // for custom ordering
  create_at     DateTime @default(now())

  Collection KanjiCollections @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  Kanji      Kanji            @relation(fields: [kanji_id], references: [id], onDelete: Cascade)

  @@unique([collection_id, kanji_id])
  @@index([collection_id])
  @@index([kanji_id])
}

enum QuizType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_IN_BLANK
  MATCHING
}

enum QuestionType {
  KANJI_TO_MEANING // Cho kanji, chọn nghĩa
  MEANING_TO_KANJI // Cho nghĩa, chọn kanji
  KANJI_TO_ONYOMI // Cho kanji, chọn âm Hán
  KANJI_TO_KUNYOMI // Cho kanji, chọn âm Kun
  READING_TO_KANJI // Cho reading, chọn kanji
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

model Quiz {
  id            Int             @id @default(autoincrement())
  title         String
  description   String?
  user_id       Int? // null = public quiz
  is_public     Boolean         @default(false)
  quiz_type     QuizType        @default(MULTIPLE_CHOICE)
  difficulty    DifficultyLevel @default(MEDIUM)
  time_limit    Int? // in seconds, null = no limit
  passing_score Int             @default(70) // percentage
  create_at     DateTime        @default(now())
  update_at     DateTime        @updatedAt

  User           Users?              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Questions      QuizQuestion[]
  Results        QuizResult[]
  PublicRequests PublicQuizRequest[]

  @@index([user_id])
  @@index([is_public])
}

model QuizQuestion {
  id             Int          @id @default(autoincrement())
  quiz_id        Int
  kanji_id       Int?
  question_type  QuestionType
  question_text  String // Nội dung câu hỏi
  correct_answer String // Đáp án đúng
  options        Json? // Các lựa chọn cho multiple choice (array of strings)
  explanation    String? // Giải thích đáp án
  points         Int          @default(1)
  order_index    Int? // Thứ tự câu hỏi
  create_at      DateTime     @default(now())
  update_at      DateTime     @updatedAt

  Quiz  Quiz   @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  Kanji Kanji? @relation(fields: [kanji_id], references: [id], onDelete: Cascade)

  @@index([quiz_id])
  @@index([kanji_id])
}

model QuizResult {
  id              Int      @id @default(autoincrement())
  quiz_id         Int
  user_id         Int
  score           Int // Điểm số
  total_questions Int // Tổng số câu hỏi
  correct_answers Int // Số câu trả lời đúng
  time_taken      Int? // Thời gian làm bài (seconds)
  answers         Json // Chi tiết các câu trả lời {question_id, user_answer, is_correct}
  completed_at    DateTime @default(now())

  Quiz Quiz  @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  User Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([quiz_id])
  @@index([user_id])
  @@index([completed_at])
}

model FlashcardDeck {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  user_id     Int? // null = public deck
  is_public   Boolean  @default(false)
  create_at   DateTime @default(now())
  update_at   DateTime @updatedAt

  User           Users?              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Cards          FlashcardCard[]
  PublicRequests PublicDeckRequest[]

  @@index([user_id])
  @@index([is_public])
}

model FlashcardCard {
  id          Int      @id @default(autoincrement())
  deck_id     Int
  kanji_id    Int?
  front_text  String // Text hiển thị mặt trước (có thể là kanji, nghĩa, reading, etc.)
  back_text   String // Text hiển thị mặt sau (câu trả lời, giải thích)
  hint        String? // Gợi ý (optional)
  order_index Int? // Thứ tự card trong deck
  create_at   DateTime @default(now())
  update_at   DateTime @updatedAt

  Deck  FlashcardDeck @relation(fields: [deck_id], references: [id], onDelete: Cascade)
  Kanji Kanji?        @relation(fields: [kanji_id], references: [id], onDelete: SetNull)

  @@index([deck_id])
  @@index([kanji_id])
}

enum PublicDeckRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PublicDeckRequest {
  id          Int                     @id @default(autoincrement())
  deck_id     Int
  user_id     Int
  reason      String
  status      PublicDeckRequestStatus @default(PENDING)
  admin_note  String?
  reviewed_by Int?
  reviewed_at DateTime?
  create_at   DateTime                @default(now())
  update_at   DateTime                @updatedAt

  Deck       FlashcardDeck @relation(fields: [deck_id], references: [id], onDelete: Cascade)
  User       Users         @relation("UserPublicRequests", fields: [user_id], references: [id], onDelete: Cascade)
  ReviewedBy Users?        @relation("AdminReviewedRequests", fields: [reviewed_by], references: [id])

  @@index([deck_id])
  @@index([user_id])
  @@index([status])
}

enum PublicQuizRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PublicQuizRequest {
  id          Int                     @id @default(autoincrement())
  quiz_id     Int
  user_id     Int
  reason      String
  status      PublicQuizRequestStatus @default(PENDING)
  admin_note  String?
  reviewed_by Int?
  reviewed_at DateTime?
  create_at   DateTime                @default(now())
  update_at   DateTime                @updatedAt

  Quiz       Quiz   @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  User       Users  @relation("UserPublicQuizRequests", fields: [user_id], references: [id], onDelete: Cascade)
  ReviewedBy Users? @relation("AdminReviewedQuizRequests", fields: [reviewed_by], references: [id])

  @@index([quiz_id])
  @@index([user_id])
  @@index([status])
}

// ==================== USER PROFILE TABLES ====================

model UserProfile {
  id               Int      @id @default(autoincrement())
  user_id          Int      @unique
  display_name     String?
  bio              String?
  location         String?
  website          String?
  total_kanji      Int      @default(0) // Tổng số kanji đã học
  total_quiz       Int      @default(0) // Tổng số quiz đã làm
  total_flashcard  Int      @default(0) // Tổng số flashcard đã học
  total_points     Int      @default(0) // Tổng điểm số
  current_streak   Int      @default(0) // Số ngày học liên tiếp hiện tại
  longest_streak   Int      @default(0) // Kỷ lục streak
  last_activity_at DateTime @default(now())
  settings         Json? // User settings (theme, notifications, etc.)
  create_at        DateTime @default(now())
  update_at        DateTime @updatedAt

  User Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

enum ActivityType {
  QUIZ_COMPLETED
  FLASHCARD_STUDIED
  KANJI_LEARNED
  POST_CREATED
  COMMENT_CREATED
}

model LearningHistory {
  id            Int          @id @default(autoincrement())
  user_id       Int
  activity_type ActivityType
  activity_data Json // Lưu chi tiết hoạt động {quiz_id, score, kanji_id, etc.}
  points_earned Int          @default(0)
  create_at     DateTime     @default(now())

  User Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([create_at])
  @@index([activity_type])
}

// ==================== COMMUNITY TABLES ====================

enum PostCategory {
  DISCUSSION // Thảo luận chung
  TIPS // Chia sẻ tips học tập
  QUESTION // Câu hỏi
  STUDY_LOG // Nhật ký học tập
  RESOURCES // Chia sẻ tài liệu
}

model CommunityPost {
  id          Int          @id @default(autoincrement())
  user_id     Int
  title       String
  content     String // Rich text content
  category    PostCategory @default(DISCUSSION)
  tags        String[] // Array of tags
  attachments String[]     @default([]) // Array of file URLs (images, documents, etc.)
  view_count  Int          @default(0)
  is_pinned   Boolean      @default(false)
  is_locked   Boolean      @default(false)
  create_at   DateTime     @default(now())
  update_at   DateTime     @updatedAt

  User     Users              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Comments CommunityComment[]
  Likes    PostLike[]

  @@index([user_id])
  @@index([category])
  @@index([create_at])
  @@index([is_pinned])
}

model CommunityComment {
  id        Int      @id @default(autoincrement())
  post_id   Int
  user_id   Int
  content   String
  parent_id Int? // For nested comments/replies
  create_at DateTime @default(now())
  update_at DateTime @updatedAt

  Post    CommunityPost      @relation(fields: [post_id], references: [id], onDelete: Cascade)
  User    Users              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Parent  CommunityComment?  @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  Replies CommunityComment[] @relation("CommentReplies")
  Likes   CommentLike[]

  @@index([post_id])
  @@index([user_id])
  @@index([parent_id])
  @@index([create_at])
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

model PostLike {
  id        Int      @id @default(autoincrement())
  post_id   Int
  user_id   Int
  vote_type VoteType @default(UPVOTE)
  create_at DateTime @default(now())

  Post CommunityPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  User Users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
  @@index([post_id])
  @@index([user_id])
  @@index([vote_type])
}

model CommentLike {
  id         Int      @id @default(autoincrement())
  comment_id Int
  user_id    Int
  vote_type  VoteType @default(UPVOTE)
  create_at  DateTime @default(now())

  Comment CommunityComment @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  User    Users            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([comment_id, user_id])
  @@index([comment_id])
  @@index([user_id])
  @@index([vote_type])
}
