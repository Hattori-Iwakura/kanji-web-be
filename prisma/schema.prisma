// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum StudySessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum QuizQuestionType {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  DRAWING
}

enum QuizDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model Users {
  id             Int      @id @default(autoincrement())
  account        String   @unique
  hash_password  String
  email          String   @unique
  profile_image  String?
  role           UserRole @default(USER)
  is_system      Boolean  @default(false)
  is_active      Boolean  @default(true)
  is_first_login Boolean  @default(true)
  create_at      DateTime @default(now())
  update_at      DateTime @updatedAt

  sessions         UserSession[]
  KanjiCollections KanjiCollections[]
  FlashcardDecks   FlashcardDeck[]
  StudySessions    FlashcardStudySession[]
  KanjiProgress    KanjiProgress[]
  KanjiLists       KanjiList[]
  Quizzes          Quiz[]
  QuizAttempts     QuizAttempt[]
}

model UserSession {
  id               Int      @id @default(autoincrement())
  sessionId        String   @unique
  userId           Int
  user             Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String?
  revoked          Boolean  @default(false)
  userAgent        String?
  ip               String?
  createdAt        DateTime @default(now())
  lastActiveAt     DateTime @default(now())
  expiresAt        DateTime
  metadata         Json?

  @@index([userId])
  @@index([sessionId])
}

model Kanji {
  id                   Int      @id @default(autoincrement())
  character            String   @unique
  onyomi               String?
  kunyomi              String?
  meanings             String
  meaning_explanations String?
  stroke_count         Int?
  jlpt                 Int?
  grade                Int?
  frequency            Int?
  radicals             String?
  stroke_order         Json? // Array of SVG path data for each stroke
  components           Json? // Array of kanji components/parts
  create_at            DateTime @default(now())
  update_at            DateTime @updatedAt

  KanjiCollectionItems KanjiCollectionItems[]
  FlashcardCards       FlashcardCard[]
  Examples             KanjiExample[]
  Progress             KanjiProgress[]
  ListItems            KanjiListItem[]
}

// Kanji example words/compounds
model KanjiExample {
  id         Int      @id @default(autoincrement())
  kanji_id   Int
  word       String
  reading    String
  meaning    String
  word_type  String? // "noun", "verb", "adjective", etc.
  jlpt_level Int?
  frequency  Int?
  create_at  DateTime @default(now())

  Kanji Kanji @relation(fields: [kanji_id], references: [id], onDelete: Cascade)

  @@index([kanji_id])
  @@index([jlpt_level])
}

// User's kanji learning progress
model KanjiProgress {
  id             Int       @id @default(autoincrement())
  user_id        Int
  kanji_id       Int
  status         String    @default("new") // "new", "learning", "known", "mastered"
  times_reviewed Int       @default(0)
  times_correct  Int       @default(0)
  last_reviewed  DateTime?
  first_learned  DateTime  @default(now())
  mastered_at    DateTime?
  create_at      DateTime  @default(now())
  update_at      DateTime  @updatedAt

  User  Users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Kanji Kanji @relation(fields: [kanji_id], references: [id], onDelete: Cascade)

  @@unique([user_id, kanji_id])
  @@index([user_id, status])
  @@index([kanji_id])
}

// User's custom kanji lists
model KanjiList {
  id          Int      @id @default(autoincrement())
  user_id     Int
  name        String
  description String?
  is_public   Boolean  @default(false)
  create_at   DateTime @default(now())
  update_at   DateTime @updatedAt

  User  Users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Items KanjiListItem[]

  @@index([user_id])
}

model KanjiListItem {
  id          Int      @id @default(autoincrement())
  list_id     Int
  kanji_id    Int
  order_index Int
  notes       String?
  added_at    DateTime @default(now())

  List  KanjiList @relation(fields: [list_id], references: [id], onDelete: Cascade)
  Kanji Kanji     @relation(fields: [kanji_id], references: [id], onDelete: Cascade)

  @@unique([list_id, kanji_id])
  @@index([list_id, order_index])
  @@index([kanji_id])
}

model KanjiCollections {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  user_id         Int? // null = public collection
  is_public       Boolean  @default(false)
  collection_type String   @default("custom") // "custom", "jlpt", "grade", "category"
  metadata        Json? // store additional config like jlpt level, category ids, etc.
  create_at       DateTime @default(now())
  update_at       DateTime @updatedAt

  Users                Users?                 @relation(fields: [user_id], references: [id])
  KanjiCollectionItems KanjiCollectionItems[]

  @@index([user_id])
  @@index([collection_type])
}

model KanjiCollectionItems {
  id            Int      @id @default(autoincrement())
  collection_id Int
  kanji_id      Int
  order_index   Int? // for custom ordering
  create_at     DateTime @default(now())

  Collection KanjiCollections @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  Kanji      Kanji            @relation(fields: [kanji_id], references: [id], onDelete: Cascade)

  @@unique([collection_id, kanji_id])
  @@index([collection_id])
  @@index([kanji_id])
}

// ==================== Flashcard Models ====================

model FlashcardDeck {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  user_id     Int
  source_type String   @default("custom") // "custom", "kanji_list"
  source_id   Int? // KanjiCollections.id if source_type = "kanji_list"
  is_public   Boolean  @default(false)
  total_cards Int      @default(0)
  cards_due   Int      @default(0)
  cards_new   Int      @default(0)
  create_at   DateTime @default(now())
  update_at   DateTime @updatedAt

  User          Users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Cards         FlashcardCard[]
  StudySessions FlashcardStudySession[]

  @@index([user_id])
  @@index([source_type])
}

model FlashcardCard {
  id               Int       @id @default(autoincrement())
  deck_id          Int
  kanji_id         Int
  front_content    String // Kanji character
  back_content     String // Meanings, readings (JSON)
  difficulty       Int       @default(0) // 0-5 scale
  order_index      Int       @default(0)
  next_review_at   DateTime  @default(now())
  interval_days    Int       @default(1) // Days until next review
  ease_factor      Float     @default(2.5) // SM-2 algorithm
  repetitions      Int       @default(0) // Number of successful reviews
  last_reviewed_at DateTime?
  is_new           Boolean   @default(true)
  create_at        DateTime  @default(now())
  update_at        DateTime  @updatedAt

  Deck    FlashcardDeck     @relation(fields: [deck_id], references: [id], onDelete: Cascade)
  Kanji   Kanji             @relation(fields: [kanji_id], references: [id], onDelete: Cascade)
  Reviews FlashcardReview[]

  @@unique([deck_id, kanji_id])
  @@index([deck_id])
  @@index([order_index])
  @@index([next_review_at])
  @@index([kanji_id])
  @@index([is_new])
}

model FlashcardReview {
  id         Int      @id @default(autoincrement())
  card_id    Int
  session_id Int
  rating     Int // 0-5 (0=again, 1=hard, 2=good, 3=easy, 4=very easy, 5=perfect)
  time_spent Int // Seconds
  create_at  DateTime @default(now())

  Card    FlashcardCard         @relation(fields: [card_id], references: [id], onDelete: Cascade)
  Session FlashcardStudySession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([card_id])
  @@index([session_id])
}

model FlashcardStudySession {
  id            Int                @id @default(autoincrement())
  deck_id       Int
  user_id       Int
  cards_studied Int                @default(0)
  cards_correct Int                @default(0)
  cards_wrong   Int                @default(0)
  total_time    Int                @default(0) // Seconds
  completed     Boolean            @default(false)
  status        StudySessionStatus @default(ACTIVE)
  cards_total   Int                @default(0)
  current_index Int                @default(0)
  card_order    Json?
  settings      Json?
  paused_at     DateTime?
  completed_at  DateTime?
  create_at     DateTime           @default(now())
  update_at     DateTime           @updatedAt

  Deck    FlashcardDeck     @relation(fields: [deck_id], references: [id], onDelete: Cascade)
  User    Users             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Reviews FlashcardReview[]

  @@index([deck_id])
  @@index([user_id])
  @@index([create_at])
}

model Quiz {
  id          Int            @id @default(autoincrement())
  user_id     Int
  title       String
  description String?
  difficulty  QuizDifficulty @default(BEGINNER)
  category    String? // e.g., "JLPT N5", "Kanji Grade 1", "Vocabulary"
  tags        String[]       @default([])
  is_public   Boolean        @default(false)
  create_at   DateTime       @default(now())
  update_at   DateTime       @updatedAt

  User      Users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Questions Question[]
  Attempts  QuizAttempt[]

  @@index([user_id])
  @@index([category])
  @@index([difficulty])
  @@index([is_public])
}

model Question {
  id             Int              @id @default(autoincrement())
  quiz_id        Int
  type           QuizQuestionType
  question       String // The question text
  correct_answer String // For MULTIPLE_CHOICE: the correct option key (A/B/C/D), FILL_IN_BLANK: the answer, DRAWING: the kanji character
  options        Json? // For MULTIPLE_CHOICE: {A: "option1", B: "option2", ...}
  metadata       Json? // For DRAWING: {hint: "...", strokeCount: 5}, FILL_IN_BLANK: {blankPosition: 2}
  order_index    Int              @default(0)
  points         Int              @default(1)
  time_limit     Int? // Seconds (optional)
  explanation    String? // Explanation shown after answering
  create_at      DateTime         @default(now())
  update_at      DateTime         @updatedAt

  Quiz    Quiz         @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  Answers QuizAnswer[]

  @@index([quiz_id])
  @@index([type])
  @@index([order_index])
}

model QuizAttempt {
  id           Int       @id @default(autoincrement())
  user_id      Int
  quiz_id      Int
  score        Int       @default(0)
  max_score    Int       @default(0)
  started_at   DateTime  @default(now())
  completed_at DateTime?
  time_spent   Int       @default(0) // Total seconds spent
  is_completed Boolean   @default(false)

  User    Users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Quiz    Quiz         @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  Answers QuizAnswer[]

  @@index([user_id])
  @@index([quiz_id])
  @@index([started_at])
  @@index([is_completed])
}

model QuizAnswer {
  id          Int      @id @default(autoincrement())
  attempt_id  Int
  question_id Int
  user_answer String // User's answer (option key, text, or recognized kanji)
  is_correct  Boolean  @default(false)
  points      Int      @default(0)
  time_spent  Int      @default(0) // Seconds for this question
  metadata    Json? // For DRAWING: {confidence: 0.95, predictions: [...]}
  answered_at DateTime @default(now())

  Attempt  QuizAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  Question Question    @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([attempt_id])
  @@index([question_id])
  @@index([is_correct])
}
